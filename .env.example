# Copy to .env before running docker compose up

# Every service connects as this user to its own database; nothing connects as root.
# The root password is only used to initialise the MySQL containers and by their health check.
MYSQL_USER=booking
MYSQL_PASSWORD=booking
MYSQL_ROOT_PASSWORD=root

# Base64-encoded 256-bit HMAC key, shared by api-gateway and user-service.
# Generate a fresh one with:
#   openssl rand -base64 32
JWT_SECRET=ZGV2LW9ubHktc2VjcmV0LWtleS1jaGFuZ2UtbWUtaW4tcHJvZHVjdGlvbi0xMjM0NTY3ODkw
JWT_ISSUER=appointment-booking-system
JWT_EXPIRATION=3600

# create-drop | update | validate | none
DDL_AUTO=update

# Host port for the API Gateway (the single entry point). Change this if port 8080
# is already taken on your machine, e.g. by a local Apache/XAMPP: GATEWAY_PORT=18080
GATEWAY_PORT=8080

# Message broker. The services publish domain events here and notification-service
# consumes them; the management console is at http://localhost:15672
RABBITMQ_USER=booking
RABBITMQ_PASSWORD=booking

# Mailpit is a local SMTP server: nothing leaves the machine and every message is
# visible at http://localhost:8025 . Set MAIL_ENABLED=false to skip SMTP entirely -
# notifications are then only recorded and readable through /api/notifications.
MAIL_ENABLED=true
MAIL_FROM=no-reply@appointment-booking.local

# Base of the links that appear in the e-mails. They point at the gateway, so change
# the port here too if you changed GATEWAY_PORT.
ACTIVATION_BASE_URL=http://localhost:8080/api/auth/activate
PASSWORD_RESET_BASE_URL=http://localhost:8080/api/auth/reset-password
