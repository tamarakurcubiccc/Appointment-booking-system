# Copy to .env before running docker compose up
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking

# Base64-encoded 256-bit HMAC key, shared by api-gateway and user-service.
# Generate a fresh one with:
#   openssl rand -base64 32
JWT_SECRET=ZGV2LW9ubHktc2VjcmV0LWtleS1jaGFuZ2UtbWUtaW4tcHJvZHVjdGlvbi0xMjM0NTY3ODkw
JWT_ISSUER=appointment-booking-system
JWT_EXPIRATION=3600

# create-drop | update | validate | none
DDL_AUTO=update

# Host port for the API Gateway (the single entry point). Change this if port 8080
# is already taken on your machine, e.g. by a local Apache/XAMPP: GATEWAY_PORT=18080
GATEWAY_PORT=8080
